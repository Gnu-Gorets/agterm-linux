+fn teardownTestApp() App {
+    var app: App = undefined;
+    app.alloc = std.testing.allocator;
+    app.mailbox = .{};
+    app.deferred = .empty;
+    return app;
+}
+
+test "teardown releases a producer already blocked on the full app mailbox" {
+    if (builtin.single_threaded) return error.SkipZigTest;
+    const io = global.io();
+    var app = teardownTestApp();
+    defer app.deferred.deinit(app.alloc);
+    var rt_storage: u8 align(@alignOf(apprt.Surface)) = 0;
+    const rt: *apprt.Surface = @ptrCast(&rt_storage);
+    var closing: Surface = undefined;
+    closing.rt_surface = rt;
+    var other: Surface = undefined;
+    const capacity = @typeInfo(@FieldType(Mailbox.Queue, "data")).array.len;
+    for (0..capacity) |i| {
+        const message: Message = if (i % 2 == 0)
+            .{ .surface_message = .{ .surface = &closing, .message = .ring_bell } }
+        else
+            .{ .surface_message = .{ .surface = &other, .message = .ring_bell } };
+        try std.testing.expect(app.mailbox.push(io, message, .instant) > 0);
+    }
+    const Producer = struct {
+        fn run(queue: *Mailbox.Queue, surface: *Surface) void {
+            _ = queue.push(global.io(), .{ .surface_message = .{ .surface = surface, .message = .{ .child_exited = .{ .exit_code = 0, .runtime_ms = 1 } } } }, .forever);
+            _ = queue.push(global.io(), .quit, .forever);
+        }
+    };
+    const producer = try std.Thread.spawn(.{}, Producer.run, .{ &app.mailbox, &closing });
+    while (true) {
+        app.mailbox.mutex.lockUncancelable(io);
+        const blocked = app.mailbox.not_full_waiters > 0;
+        app.mailbox.mutex.unlock(io);
+        if (blocked) break;
+        try std.Io.sleep(io, .fromMilliseconds(1), .awake);
+    }
+    var drain: TeardownDrain = .{ .app = &app, .surface = &closing };
+    drain.start();
+    producer.join();
+    drain.finish();
+    try std.testing.expect(app.mailbox.pop(io) == null);
+    try std.testing.expectEqual(capacity / 2 + 1, app.deferred.items.len);
+    for (app.deferred.items[0 .. capacity / 2]) |message| {
+        try std.testing.expect(message.surface_message.surface == &other);
+    }
+    try std.testing.expect(app.deferred.items[capacity / 2] == .quit);
+}
+
