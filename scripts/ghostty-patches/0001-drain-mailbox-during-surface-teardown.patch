+    try app.deferred.append(app.alloc, .{ .close = &closing });
+    try app.deferred.append(app.alloc, .{ .redraw_surface = rt });
+    try app.deferred.append(app.alloc, .{ .surface_message = .{ .surface = &closing, .message = .{ .pwd_change = pwd } } });
+    try app.deferred.append(app.alloc, .{ .new_window = .{ .parent = &closing } });
+    try app.deferred.append(app.alloc, .{ .redraw_surface = other_rt });
+    _ = app.mailbox.push(io, .{ .surface_message = .{ .surface = &other, .message = .ring_bell } }, .instant);
+    var drain: TeardownDrain = .{ .app = &app, .surface = &closing };
+    drain.start();
+    drain.finish();
+    try std.testing.expectEqual(@as(usize, 3), app.deferred.items.len);
+    try std.testing.expect(app.deferred.items[0].new_window.parent == null);
+    try std.testing.expect(app.deferred.items[1].redraw_surface == other_rt);
+    try std.testing.expect(app.deferred.items[2].surface_message.surface == &other);
+}
