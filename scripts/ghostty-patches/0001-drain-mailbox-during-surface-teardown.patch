+test "teardown releases a frame completion blocked on the app mailbox" {
+    if (builtin.single_threaded) return error.SkipZigTest;
+    const io = global.io();
+    var app = teardownTestApp();
+    defer app.deferred.deinit(app.alloc);
+    var rt_storage: u8 align(@alignOf(apprt.Surface)) = 0;
+    const rt: *apprt.Surface = @ptrCast(&rt_storage);
+    var closing: Surface = undefined;
+    closing.rt_surface = rt;
+    var other: Surface = undefined;
+    const capacity = @typeInfo(@FieldType(Mailbox.Queue, "data")).array.len;
+    for (0..capacity) |_| {
+        try std.testing.expect(app.mailbox.push(io, .{ .surface_message = .{
+            .surface = &other,
+            .message = .ring_bell,
+        } }, .instant) > 0);
+    }
+    var frame_done: std.Io.Semaphore = .{ .permits = 0 };
+    const Callback = struct {
+        fn run(queue: *Mailbox.Queue, surface: *Surface, frame: *std.Io.Semaphore) void {
+            _ = queue.push(global.io(), .{ .surface_message = .{
+                .surface = surface,
+                .message = .{ .renderer_health = .unhealthy },
+            } }, .forever);
+            frame.post(global.io());
+        }
+    };
+    const callback = try std.Thread.spawn(.{}, Callback.run, .{ &app.mailbox, &closing, &frame_done });
+    while (true) {
+        app.mailbox.mutex.lockUncancelable(io);
+        const blocked = app.mailbox.not_full_waiters > 0;
+        app.mailbox.mutex.unlock(io);
+        if (blocked) break;
+        try std.Io.sleep(io, .fromMilliseconds(1), .awake);
+    }
+    var drain: TeardownDrain = .{ .app = &app, .surface = &closing };
+    drain.start();
+    frame_done.waitUncancelable(io);
+    drain.finish();
+    callback.join();
+    try std.testing.expect(app.mailbox.pop(io) == null);
+    try std.testing.expectEqual(capacity, app.deferred.items.len);
+    for (app.deferred.items) |message| {
+        try std.testing.expect(message.surface_message.surface == &other);
+    }
+}
